་ནང་སྦྱར། ལྡེ་མིག་གསར་པར་སྐར་མ་ ༡༠ ནས་ཆུ་ཚོད་ ༢ བར་འགུལ་སྐྱོད་ཆེད་དགོས — ལེགས་པོར་ལས་སྐབས་འདིར་ ✓ ཤར་འོང་།","owm_note":"ཁྱེད་ཀྱི་ལྡེ་མིག་སྒྲིག་ཆས་འདིར་གནས་ཡོད། Weatherglass རིན་མེད་ཡིན; ཁྱེད་རང་ཉིད་ཀྱི་བེད་སྤྱོད་ཆེད་ OpenWeatherMap གྱི་རིན་མེད་གནས་རིམ་ཆོག་ཤོས།","center":"དབུས།","about_btn":"ⓘ སྐོར་གྱི་གནས་ཚུལ་དང་བཀའ་དྲིན།","contact":"ང་ཚོར་འབྲེལ་བ།","done":"ཟིན།","about_tag":"གནམ་གྱི་རྣམ་པ་གྲུབ་སའི་གནས།","about_lead":"རེ་འདོད་ལྟར་ད་ལྟའི་སྲོག་ཤུགས་ལེན་མཁན་གྱི་མཐུད་ལམ་མེད་པའི་གནམ་གཤིས་ས་ཁྲ་ཞིག་ཡིན། འཛམ་གླིང་ཧྲིལ་པོའི་གནམ་གཤིས་རྒྱུན་ལྡན་སྔོན་ནས་བཞག་ཡོད་ཅིང་མཐུད་ལམ་མེད་པར་ཀློག་ཐུབ; ད་ལྟའི་གནས་སྟངས, ཆ་འཕྲིན, ཉེན་བརྡ་དང་རི་སི་ཊར་ཁེབས་རྣམས་ཁྱེད་ཀྱིས་རེ་འདོད་བྱས་སྐབས་ཙམ་ལེན་ཐུབ།","about_cred":"<li><b>གནམ་གཤིས་རྒྱུན་ལྡན།</b> — WMO Climatological Standard Normals ༡༩༩༡–༢༠༢༠, NOAA / NCEI བརྒྱུད། སྤྱི་སྤྱོད་ཡིན།</li><li><b>རྩིས་བརྟགས་རྒྱུན་ལྡན (ཁྱབ་ཁོངས་བཀང་བ)</b> — NASA POWER (MERRA-2), ༢༠༠༡–༢༠༢༠། སྤྱི་སྤྱོད་ཡིན།</li><li><b>ད་ལྟའི་གནས་སྟངས་དང་ཆ་འཕྲིན།</b> — Open-Meteo. CC BY 4.0.</li><li><b>ལོ་རྒྱུས་དང་ཡང་བསྐྱར་དབྱེ་ཞིབ།</b> — Open-Meteo Archive (ERA5). CC BY 4.0.</li><li><b>ཨ་མེ་རི་ཀའི་ཉེན་བརྡ།</b> — US National Weather Service (api.weather.gov). སྤྱི་སྤྱོད་ཡིན།</li><li><b>རྒྱལ་ཡོངས་ཉེན་བརྡ (ཐའེ་ལེནཌ)</b> — Thai Meteorological Department (TMD). སྤྱི་སྤྱོད་ཡིན།</li><li><b>འཛམ་གླིང་གནམ་གཤིས་གནས་ཚུལ།</b> — GDACS, European Commission (JRC) / UN OCHA. CC BY 4.0.</li><li><b>རི་སི་ཊར་གནམ་གཤིས་ཁེབས།</b> — © OpenWeatherMap (ཁྱེད་རང་ཉིད་ཀྱི་རིན་མེད་ལྡེ་མིག་གིས་བཟོས)།</li><li><b>མཚོ་འགྲམ, ས་མཚམས་དང་ས་ཆ་འཚོལ་ཞིབ།</b> — Natural Earth. སྤྱི་སྤྱོད་ཡིན།</li><li><b>ཐའེ་གནས་མིང་།</b> — Wikidata ཡིག་བྱང་། CC0.</li><li><b>འཚུབ་རླུང་གི་ལམ།</b> — NOAA IBTrACS.</li><li><b>Equal Earth འཕྲུལ་བཀོད།</b> — Šavrič, Patterson &amp; Jenny (2018), ཉེར་སྤྱོད་ནང་རྩིས་བརྟགས་བྱས།</li>","cred_h":"གྲངས་དོན་དང་བཀའ་དྲིན།","privacy_h":"གསང་སྤྱོད།","about_privacy":"ཁྱེད་ཀྱི་གནས་ཁང་ཁབ་རྟགས་དང་ OpenWeatherMap ལྡེ་མིག་བརའུ་ཟར་འདིར་ཙམ་གནས་ཡོད་ཅིང་ནམ་ཡང་གང་དུའང་མི་སྐུར། ཉེར་སྤྱོད་འདི་མཐུད་ལམ་གང་ཡང་མེད་པར་འགོ་འཛུགས; ཁྱེད་ཀྱིས་རེ་འདོད་བྱས་པའི་ད་ལྟའི་གྲངས་དོན་ཆེད་ཙམ་འབྲེལ་བ་བྱེད་ཅིང་དགོས་པའི་ཐིག་ཚད་ཙམ་སྐུར།","about_foot":"Weatherglass — རིན་མེད་དང་མཐུད་ལམ་མེད་པར་ཐོག་མར་བཟོས། ཀློག་ཐེངས་རེ་རེའི་དུས་ཚོད་སྟོན; མཐུད་ལམ་མེད་སྐབས་སྔོན་བཞག་རྒྱུན་ལྡན་གནས་ཡོད།","no_alerts":"ཐིག་ཕྲན་འདིར་ NWS ཉེན་བརྡ་འགུལ་སྐྱོད་བྱེད་བཞིན་པ་མེད།","wind":"རླུང་།","as_of":"བར།","fc_high":"ཉིན་ ༧ འི་མཐོ་ཤོས ({u})","fc_precip":"ཉིན་ ༧ འི་ཆར་ཚད (མི་ལི་མི་ཊར)","fetch_failed":"ད་ལྟའི་གྲངས་དོན་ལེན་མ་ཐུབ: {r}","last_reading":"མཐའ་མའི་ཀློག་ཐེངས, བར།","fetching":"ལེན་བཞིན་པ…","no_source":"ད་ལྟའི་འབྱུང་ཁུངས་བཀོད་སྒྲིག་མེད།","no_natl_alerts":"ད་ལྟ་འགུལ་སྐྱོད་ཉེན་བརྡ་མེད།","until":"བར་དུ།","warn_src_note":"ཉེན་བརྡ་ཡོངས་ཕྱོགས་སྤྲོད་ལས་ཁུངས་ཀྱི་ཡིན་ཞིང་གནས་ཚུལ་ཇི་བཞིན་སྟོན།","news_empty":"ད་ལྟ་ GDACS ནས་གནམ་གཤིས་བྱ་བ་ཆེན་པོ་སྙན་ཞུ་མ་བྱུང་།","news_cors":"འཛམ་གླིང་གནམ་གཤིས་གནས་ཚུལ་ཉེར་སྤྱོད་སྒྲིག་ཟིན་པའི་ནང་ཙམ་འགུལ་སྐྱོད་བྱེད — GDACS འཕྲིན་ཐུང་བརའུ་ཟར་ནས་ཀློག་མི་ཐུབ (CORS མེད)།","awaits":"ད་ལྟའི་འབྱུང་ཁུངས ({name}) ཆོག་མཆན་ར་སྤྲོད་གོ་རིམ་སྒུག་བཞིན — སྔོན་བཞག་རྒྱུན་ལྡན་ཙམ་སྟོན་བཞིན།","dow_0":"ཉི་མ།","dow_1":"ཟླ་བ།","dow_2":"མིག་དམར།","dow_3":"ལྷག་པ།","dow_4":"ཕུར་བུ།","dow_5":"པ་སངས།","dow_6":"སྤེན་པ།","mon_0":"ཟླ་ ༡","mon_1":"ཟླ་ ༢","mon_2":"ཟླ་ ༣","mon_3":"ཟླ་ ༤","mon_4":"ཟླ་ ༥","mon_5":"ཟླ་ ༦","mon_6":"ཟླ་ ༧","mon_7":"ཟླ་ ༨","mon_8":"ཟླ་ ༩","mon_9":"ཟླ་ ༡༠","mon_10":"ཟླ་ ༡༡","mon_11":"ཟླ་ ༡༢","wx_0":"གནམ་གསལ།","wx_1":"ཕལ་ཆེར་གསལ་བ།","wx_2":"ཕྱོགས་རེ་སྤྲིན་ཅན།","wx_3":"སྤྲིན་གྱིས་ཁེབས།","wx_45":"མུག་པ།","wx_48":"ཁྱག་མུག","wx_51":"ཆར་ཕྲན་ཞན་པ།","wx_53":"ཆར་ཕྲན།","wx_55":"ཆར་ཕྲན་དྲག་པོ།","wx_56":"ཁྱག་བསྡུས་ཆར་ཕྲན།","wx_57":"ཁྱག་བསྡུས་ཆར་ཕྲན།","wx_61":"ཆར་པ་ཞན་པ།","wx_63":"ཆར་པ།","wx_65":"ཆར་པ་དྲག་པོ།","wx_66":"ཁྱག་བསྡུས་ཆར་པ།","wx_67":"ཁྱག་བསྡུས་ཆར་པ་དྲག་པོ།","wx_71":"ཁ་བ་ཞན་པ།","wx_73":"ཁ་བ།","wx_75":"ཁ་བ་དྲག་པོ།","wx_77":"ཁ་བའི་འབྲུ།","wx_80":"ཆར་པའི་ཐོག་མ།","wx_81":"ཆར་པའི་ཐོག་མ།","wx_82":"ཆར་པའི་ཐོག་མ་དྲག་ཤོས།","wx_85":"ཁ་བའི་ཐོག་མ།","wx_86":"ཁ་བའི་ཐོག་མ་དྲག་པོ།","wx_95":"འབྲུག་སྐད།","wx_96":"འབྲུག་སྐད, སེར་བ།","wx_99":"འབྲུག་སྐད, སེར་བ་དྲག་པོ།","fail_429":"{src} རེ་འདོད་ཚད་ལ་སླེབས (རིན་མེད་ཚད་གཞི) — སྐར་མ་གཅིག་རྗེས་ཡང་བསྐྱར་ཚོད་ལྟ","fail_http":"{src} ནས་ HTTP {code} སློག་བྱུང","fail_shape":"{src} ནས་རེ་བ་མེད་པའི་ལན་བྱུང","fail_net":"{src} དང་འབྲེལ་མཐུད་མེད (མཐུད་ལམ་མེད་པའམ་རེ་འདོད་བཀག)","lat":"བྱང་ཤར་ཐིག","long":"ཤར་ནུབ་ཐིག","alt":"མཐོ་ཚད","disc_title":"Weatherglass ལ་ཡིད་ཆེས་མ་བྱེད་གོང་།","disc_body":"<p><b>Weatherglass ནི་ཆ་འཕྲིན་ལག་ཆ་ཞིག་ཡིན་གྱི, བདེ་འཇགས་ཞབས་ཞུ་མིན།</b> གནམ་གཤིས་གྲངས་དོན, ཆ་འཕྲིན, ལོ་རྒྱུས་ཕྲེང་བ་དང་གཞུང་འབྲེལ་ཉེན་བརྡ་རྣམས་གཞན་གྱི་འབྱུང་ཁུངས་ (Open-Meteo, MET Norway, ཨ་མེ་རི་ཀའི་ National Weather Service, རྒྱལ་ཡོངས་གནམ་གཤིས་ལས་ཁུངས, GDACS, དང་ཁྱེད་རང་ཉིད་ཀྱི་ལྡེ་མིག་སྣོན་སྐབས་ OpenWeatherMap) ནས་ལེན། དེ་དག་དུས་ཡུན་རིང་བ, མ་ཚང་བ, ནོར་འཁྲུལ་ཅན་འམ་མི་འཐོབ་སྲིད་ཅིང, Weatherglass ནས་ནོར་འཁྲུལ་གྱིས་ཀློག་པའམ་སྟོན་མི་ཐུབ་སྲིད།</p><p><b>སྲོག, འཚོ་བ, རྒྱུ་དངོས་འམ་འགྲུལ་བཞུད་བདེ་འཇགས་ཉེན་ཁར་སླེབས་པའི་ཐག་གཅོད་ཆེད་ཉེར་སྤྱོད་འདི་བེད་སྤྱོད་མ་བྱེད</b> — འཚུབ་རླུང, ཆུ་ལོག, གནམ་གྲུ, གྲུ་གཟིངས, རི་འཛེགས་འམ་ཕྱི་ཁའི་ལས་ཀ་བཅས་འདུས། རྟག་ཏུ་ཁྱེད་རང་ཉིད་ཀྱི་ཉེ་འཁོར་གནམ་གཤིས་དབང་འཛིན་དང་མི་དམངས་སྲུང་སྐྱོབ་ལམ་སྟོན་ལ་བརྩི་སྲུང་གྱིས; དེ་དག་གི་ཉེན་བརྡ་འདིར་བསྟན་པའི་གང་ཡང་ལས་ཐོག་མཐོང་ཡིན།</p><p>མཐུད་ལམ་མེད་པའི་གནམ་གཤིས་ས་ཁྲ་འདིས <b>ཡུན་རིང་ཆ་སྙོམས་ (༡༩༩༡–༢༠༢༠)</b> དང་ལོ་རྒྱུས་ཡིག་ཆ་སྟོན། འདིས་རྒྱུན་ལྡན་གནས་སྟངས་བརྗོད་ཀྱི་ཡོད, ཉིན་མོ་ངེས་ཅན་ཞིག་གི་གནམ་གཤིས་ག་འདྲ་ཡིན་མིན་མ་ཡིན།</p><p><b>གནས་ཡུལ</b> ཁྱེད་ཀྱིས་བེད་སྤྱོད་ཆེད་མཐེབ་གནོན་བྱས་སྐབས་ཙམ, ཐིག་ཕྲན་དེའི་ཆེད་གནམ་གཤིས་ལེན་ཆེད་ཙམ་བེད་སྤྱོད་བྱེད་ཅིང, ང་ཚོས་ནམ་ཡང་ཉར་ཚགས་མི་བྱེད། ཁྱེད་ཀྱི་གནས་ཁང་ཁབ་རྟགས་དང་སྒྲིག་འགོད་སྒྲིག་ཆས་འདིར་ཙམ་གནས།</p><p>Weatherglass རིན་མེད་སྤྲོད, <b>“ཇི་ལྟར་གནས་པ་ལྟར”, བདེན་སྲུང་གང་ཡང་མེད་པར</b> སྤྲོད། ཁྲིམས་ཀྱིས་ཆོག་པའི་ཐིག་ཚད་མཐོ་ཤོས་བར, འདི་ཡི་རྩོམ་པ་པོས་བེད་སྤྱོད་འམ་ནང་དོན་ལ་ཡིད་ཆེས་བྱས་པའི་གོད་ཆག་འམ་གནོད་པ་གང་ཡང་ཆེད་འགན་ཁུར་མི་ལེན།</p><p><b>ང་གོ་སོང་ཞིང་ཁས་ལེན</b> ལ་མཐེབ་གནོན་བྱས་པས་ཁྱེད་ཀྱིས་བརྡ་འདི་ཀློག་ཟིན་པ་ར་སྤྲོད་བྱེད། གསར་སྒྱུར་རེ་རེའི་རྗེས་ཡང་བསྐྱར་སྟོན་ངེས།</p>","disc_accept":"ང་གོ་སོང་ཞིང་ཁས་ལེན།","disc_btn":"⚠ བརྡ་ཐོ།","disc_note":"Weatherglass 1.0 · བརྡ་ཐོ་འདི་གསར་སྒྱུར་རེ་རེར་ཐེངས་གཅིག་སྟོན།","north_t":"བྱང་ཕྱོགས་གོང་དུ།","natl_none":"{c} ཆེད་ད་དུང་གཞུང་འབྲེལ་ཉེན་བརྡའི་འཕྲིན་ཐུང་ཐོ་འགོད་མེད — ཨ་མེ་རི་ཀའི་ཉེན་བརྡ་ཉིན་རེའི་གསར་སྒྱུར་དང་མཉམ་སྟོན; ཐའེ་ལེནཌ་ནས་ TMD བེད་སྤྱོད་བྱེད།","lang_loading":"{l} ཕབ་ལེན་བྱེད་བཞིན…","lang_fail":"{l} ཕབ་ལེན་མ་ཐུབ — ཁྱེད་ཀྱི་མཐུད་ལམ་ཞིབ་བཤེར་བྱས་ཏེ་ཡང་བསྐྱར་ཚོད་ལྟ་གྱིས།","ntp_first":"ཤར་ཆེ་ཤོས།","ntp_prev":"སྔོན་མ (ཤར)","ntp_play":"འཁོར་སྐྱོད/མཚམས་འཇོག","ntp_next":"རྗེས་མ (ནུབ)","ntp_last":"ནུབ་ཆེ་ཤོས།","row_chance":"གོ་སྐབས།","xf_h":"གནམ་གཤིས་ཞིབ་ཕྲ་མང་བ།","xf_feels":"ཚོར་བའི་དྲོད་ཚད།","xf_hum":"རློན་ཚད།","xf_gust":"རླུང་འཚུབ།","xf_wdir":"རླུང་གི་ཕྱོགས།","xf_uv":"UV ཚད་གཞི།","xf_snow":"ཁ་བ་འབབ་ཚད།","xf_vis":"མཐོང་ཚད།","row_sunrise":"ཉི་ཤར།","row_sunset":"ཉི་ནུབ།","row_feels":"ཚོར་བ།","row_hum":"རློན་ཚད།","row_gust":"རླུང་འཚུབ།","row_wind":"རླུང་།","row_uv":"UV","row_snow":"ཁ་བ།","row_vis":"མཐོང་ཚད།","region_global":"འཛམ་གླིང་སྤྱི།","region_europe":"ཡོ་རོབ།","region_americas":"ཨ་མེ་རི་ཀ།","region_east_asia":"ཤར་ཨེ་ཤི་ཡ།","region_southeast_asia":"ལྷོ་ཤར་ཨེ་ཤི་ཡ།","region_south_asia":"ལྷོ་ཨེ་ཤི་ཡ།","region_west_asia":"ནུབ་ཨེ་ཤི་ཡ།","region_central_asia":"དབུས་ཨེ་ཤི་ཡ།","region_africa":"ཨཕ་རི་ཀ།","region_oceania":"རྒྱ་མཚོའི་གླིང་ཕྲན།","langpick_note":"དབྱིན་ཇིའི་སྐད་ལས་གཞན་སྐད་ཡིག་ཡོངས་ Claude ཡིས་བསྒྱུར་ཞིང, སྐད་ཡུལ་བ་ཞིག་གིས་ཞིབ་བཤེར་མ་བྱས་བར་ BETA ཞེས་རྟགས་བཀོད།"}}